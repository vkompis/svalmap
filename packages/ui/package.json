{
  "name": "@svalmap/ui",
  "version": "1.0.0",
  "description": "Shared UI components for SvalMap",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
