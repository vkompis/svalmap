{
  "name": "@svalmap/api",
  "version": "1.0.0",
  "description": "SvalMap API server",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
